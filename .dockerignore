node_modules
dist
.env
# A bare `.env` only matches the repo root. The workspace packages keep their
# own (client/.env, server/.env); without this a local `docker build` copies
# them in, and Vite bakes client/.env's dev-only VITE_BACKEND_PORT into the
# client bundle.
**/.env
.git
.github

# Real catalog/test content never belongs in the image — the catalog is
# populated via a mounted volume (infrastructure.md "Deployment (Railway +
# Terraform)"), not baked in.
catalog/
client/public/test/
client/test-fixtures/

# Terraform config/state — irrelevant to the runtime image.
infra/

# Project tooling/docs — irrelevant to the runtime image.
.project/
.claude/

*storybook.log
storybook-static
client/playwright/.cache/
client/test-results/
client/playwright-report/
